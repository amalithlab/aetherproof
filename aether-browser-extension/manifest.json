{
  "manifest_version": 3,
  "name": "AETHER Browser Provider",
  "version": "1.0.0",
  "description": "Secure local browser provider for AETHER IDE research agents.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "ws://127.0.0.1:7823/*",
    "ws://localhost:7823/*",
    "http://127.0.0.1:7823/*",
    "http://localhost:7823/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:7823 ws://localhost:7823 http://127.0.0.1:7823 http://localhost:7823;"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AETHER Browser Provider"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
